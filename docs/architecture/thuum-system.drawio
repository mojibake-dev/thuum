        <UserObject label="&lt;b&gt;SKSE 2.2.6 and the Address Library&lt;/b&gt;&lt;br&gt;skse64_1_6_1170.dll loads SKSE plugins; the Address Library for 1.6.1170 maps the IDs CommonLibSSE-NG names to this exe's addresses." tooltip="Source: lab/deploy/sky-client/README.md (install-layer.ps1); skymp/skyrim-platform/src/platform_se/skyrim_platform/Hooks.cpp names the SKSE DLL after the running exe" id="p1-skse">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#DDDDDD;strokeColor=#4D4D4D;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p1-clp">
