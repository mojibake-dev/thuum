        <mxCell id="p2-title" value="&lt;b&gt;Client hooks: how the client touches the engine&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=20;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p2-1">
          <mxGeometry x="20" y="12" width="1190" height="38" as="geometry" />
        </mxCell>
        <mxCell id="p2-sub" value="All of this runs inside SkyrimSE.exe on a player's PC. Top band: the engine. Middle band: the mechanisms Skyrim Platform gives JavaScript. Lower band: skymp5-client's services, sorted as observe, impose and suppress (docs/VERB.md). Each item names its mechanism in brackets. Messages leave and arrive through MpClientPlugin.dll (page 3)." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p2-1">
