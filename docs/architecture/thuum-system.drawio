        </mxCell>
        <UserObject label="&lt;b&gt;skymp5-client&lt;/b&gt;&lt;br&gt;A service emits sendMessage {message, reliability}; networkingService calls mpClientPlugin.send(JSON, reliable)" tooltip="Source: skymp/skymp5-client/src/services/services/networkingService.ts" id="p3-a0">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="44" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MpClientPlugin.dll: Send&lt;/b&gt;&lt;br&gt;wire_json::recognize types the JSON; a server-only message (E_TX_DIRECTION) or a non-finite number is refused" tooltip="Source: skymp/skymp-wire/crates/wire-client-ffi/src/client.rs (send_json)" id="p3-a1">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="111" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Its network thread: encode&lt;/b&gt;&lt;br&gt;wire-codec writes postcard; renet queues it on channel 0 if reliable, channel 2 if not" tooltip="Source: skymp/skymp-wire/crates/wire-transport/src/lib.rs (send_with), channels.rs" id="p3-a2">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="178" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;UDP :7777&lt;/b&gt;&lt;br&gt;netcode packets (renet_netcode); protocol id SKYMPW plus the schema version" tooltip="Source: skymp/skymp-wire/crates/wire-transport/src/lib.rs (protocol_id)" id="p3-a3">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=3;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="245" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;netcode server&lt;/b&gt;&lt;br&gt;Connect token (the lab: Unsecure); the server password in the token's user data, else refused (303); 15 s of silence drops" tooltip="Source: skymp/skymp-wire/crates/wire-transport/src/token.rs, lib.rs (RejectKind::Password)" id="p3-a4">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="312" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;renet&lt;/b&gt;&lt;br&gt;Reassembles each channel; a client whose reliable channel fills its 2 MiB is disconnected" tooltip="Source: skymp/skymp-wire/crates/wire-transport/src/limits.rs (client_channel_memory_bytes)" id="p3-a5">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="379" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Limits, before any decode&lt;/b&gt;&lt;br&gt;At most 256 KiB per message and 256 KiB per second per client (301)" tooltip="Source: skymp/skymp-wire/crates/wire-transport/src/limits.rs, lib.rs (ingest)" id="p3-a6">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="446" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;wire-codec decode&lt;/b&gt;&lt;br&gt;The whole-message cap, the variant tag, that message's byte cap, bounded fields, no trailing bytes, a canonical re-encode (101 to 104)" tooltip="Source: skymp/skymp-wire/crates/wire-codec/src/lib.rs" id="p3-a7">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="513" width="364" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Direction check&lt;/b&gt;&lt;br&gt;A server-to-client message from a client is refused (302)" tooltip="Source: skymp/skymp-wire/crates/wire-transport/src/lib.rs (client_may_send)" id="p3-a8">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="593" width="364" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;wire-validate&lt;/b&gt;&lt;br&gt;Every float finite, positions within 1e6 units, ranges, per-family token buckets (201 to 207)" tooltip="Source: skymp/skymp-wire/crates/wire-validate/src/lib.rs (validate, ClientGuard)" id="p3-a9">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="647" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;wire-json render, wire-bridge poll()&lt;/b&gt;&lt;br&gt;The JSON SkyMP's JsonOutputArchive writes, over cxx as WireEvent {Message, msg_type, json}; rejections are counted and logged, never acted on" tooltip="Source: skymp/skymp-wire/crates/wire-bridge/src/lib.rs; wire-json/src/lib.rs" id="p3-a10">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="714" width="364" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;WireServer.cpp&lt;/b&gt;&lt;br&gt;Hands the core 0x86 + JSON, the form PacketParser already read" tooltip="Source: skymp/skymp5-server/cpp/addon/WireServer.cpp (Dispatch)" id="p3-a11">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="794" width="364" height="34" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;PacketParser → ActionListener&lt;/b&gt;&lt;br&gt;MessageSerializer reads the JSON (simdjson) into a typed message; one handler per MsgType" tooltip="Source: skymp/skymp5-server/cpp/server_guest_lib/PacketParser.cpp, ActionListener.h" id="p3-a12">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
            <mxGeometry x="10" y="848" width="364" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Game rules (wire-rules)&lt;/b&gt;&lt;br&gt;The handler gathers facts and asks through rules.rs; a verdict and its bound come back (page 4)" tooltip="Source: skymp/skymp-wire/crates/wire-bridge/src/rules.rs; wire-rules/src/" id="p3-a13">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-lanea">
