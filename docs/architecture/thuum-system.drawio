        <UserObject label="&lt;b&gt;Intents: the host computes, the server validates&lt;/b&gt;&lt;br&gt;Client to server: movement (UpdateMovement), melee, arrow and spell hits (OnHit), shots (PlayerBowShot), casts (SpellCast), activation, container moves, crafting, rests (RestIntent), map marker finds, the race menu's result (UpdateAppearance)." tooltip="Sources: skymp/skymp-wire/crates/wire-schema/src/skymp.rs (each message's rung); docs/verbs/*.md (Authority); CLAUDE.md (rungs)" id="p1-rb0">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p1-rung">
