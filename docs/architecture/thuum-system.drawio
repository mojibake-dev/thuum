          <mxGeometry x="20" y="12" width="1190" height="38" as="geometry" />
        </mxCell>
        <UserObject label="Every message is one variant of wire-schema's Message enum, postcard on the network and SkyMP's JSON inside each process. SkyMP's family: wire id = MsgType + 8 (ids 9 to 50 on parity; MagicEffects is 51 on m2-effects); thuum's messages continue SkyMP's numbering from MsgType 34. The M0 family (ids 0 to 8) is reserved." tooltip="Source: skymp/skymp-wire/crates/wire-schema/src/lib.rs (TABLE), skymp.rs; docs/WIRE.md" id="p3-sub">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p3-1">
