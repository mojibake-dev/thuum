        <mxCell id="p3-f10-b1" value="&lt;b&gt;R2&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#A6A6A6;strokeColor=#808080;fontColor=#000000;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;arcSize=50;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="p3-f10">
