        <UserObject label="&lt;b&gt;Game engine: SkyrimSE.exe 1.6.1170&lt;/b&gt;&lt;br&gt;C++, closed source. Actors and AI packages, Havok physics, behavior graphs (animation), the magic system, the game's own Papyrus VM, inventory, menus and console, rendering." tooltip="The engine systems a host client runs for us (CLAUDE.md: AI packages, Havok, scenes, dialogue). Version: ADR-006, ADR-025." id="p1-eng">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#DDDDDD;strokeColor=#4D4D4D;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="p1-clp">
