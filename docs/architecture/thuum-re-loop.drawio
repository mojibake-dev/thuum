        <UserObject label="&lt;b&gt;3 Fix, fork m2-poison&lt;/b&gt;" tooltip="Source: skymp git log m2-poison; docs/verbs/poison.md:116-143" id="re3-c3">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="re3-lc">
