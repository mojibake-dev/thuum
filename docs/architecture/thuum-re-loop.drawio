        <mxCell id="re1-f1l" value="• CommonLibSSE-NG symbol(s): &amp;lt;path/to/header.h:line&amp;gt; or UNKNOWN&lt;br&gt;• Address Library ID(s): &amp;lt;from addrlib/, never from memory&amp;gt; or UNKNOWN&lt;br&gt;• If UNKNOWN: delegated to re-analyst on &amp;lt;date&amp;gt;; hypothesis block pasted below" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-f1">
          <mxGeometry x="4" y="22" width="880" height="52" as="geometry" />
        </mxCell>
        <mxCell id="re1-f1r" value="Observe, Impose and Suppress each close on &quot;Side effects: HYPOTHESIS | CONFIRMED (&amp;lt;run id&amp;gt;)&quot;. Status: engine surface cited or delegated; T3 scenario green, no HYPOTHESIS tags.&lt;br&gt;Reviewer checklist 2: does every address come from CommonLib, addrlib, or a Ghidra reference? 6: are the HYPOTHESIS tags gone, and were they cleared by evidence?" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-f1">
          <mxGeometry x="896" y="22" width="880" height="40" as="geometry" />
        </mxCell>
        <mxCell id="re1-f1-b0" value="&lt;b&gt;HYPOTHESIS&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#595959;strokeColor=#595959;fontColor=#FFFFFF;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;arcSize=50;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="re1-f1">
          <mxGeometry x="8" y="78" width="73" height="15" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Reading CommonLibSSE-NG for 1.6.1170 (memory note, 2026-10-07)&lt;/b&gt;" tooltip="Source: memory commonlib-relocation-columns.md" id="re1-gcol">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="re1-1">
            <mxGeometry x="20" y="1019" width="560" height="273" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Two numbers in a comment: which overload?&lt;/b&gt;&lt;br&gt;REL::RelocateMember&amp;lt;T&amp;gt;(this, a, b) (REL/Relocation.h:633) takes a for SE and AE together and b for VR, and a header comment // 110, 138 is the same pair: NiNode::children 0x110, BSGeometry's runtime data 0x120 (not 0x160), NiAVObject::flags 0xF4 (not 0x10C)." tooltip="Source: memory commonlib-relocation-columns.md; CommonLibSSE-NG include/REL/Relocation.h:630-636; lab/frida/face-dump.js:45-60" id="re1-g1">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-gcol">
            <mxGeometry x="10" y="33" width="540" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;RelocateMemberIfNewer moves the comments&lt;/b&gt;&lt;br&gt;RelocateMemberIfNewer&amp;lt;T&amp;gt;(version, this, older, newer) picks newer on a runtime at or past version, and the field comments inside such a struct keep the older layout's offsets: Actor's runtime data starts at 0xE8 from 1.6.629 (Actor.h:712), so race /* 1F0 */ sits at 0x1F8 on 1.6.1170. TESObjectREFR's fixed members (data 0x40, loadedData 0x68) do not shift." tooltip="Source: memory commonlib-relocation-columns.md; CommonLibSSE-NG include/RE/A/Actor.h:712; lab/frida/face-dump.js:56" id="re1-g2">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-gcol">
            <mxGeometry x="10" y="109" width="540" height="76" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;And how it was learned&lt;/b&gt;&lt;br&gt;A NiTexture is a NiObject: its name sits at +0x20, a NiAVObject's at +0x10. Writing face-dump.js cost two attach rounds (2026-10-07): the first dump read VR and pre-1.6.629 offsets and walked nothing. When a header gives two numbers, check which overload the accessor uses before taking the second as AE." tooltip="Source: memory commonlib-relocation-columns.md (Why, How to apply); lab/frida/face-dump.js:36-60" id="re1-g3">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#999999;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-gcol">
            <mxGeometry x="10" y="197" width="540" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Tonight's miss: where an Actor keeps its MagicTarget&lt;/b&gt;" tooltip="Source: docs/verbs/spell-cast.md:528-536; lab/frida/effect-stack-trace.js" id="re1-hcol">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="re1-1">
            <mxGeometry x="600" y="1019" width="600" height="377" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;effect-stack-trace.js read a comment&lt;/b&gt;&lt;br&gt;Its header: &quot;An Actor's MagicTarget at +0x98 on SE and AE (A/Actor.h:126; the second number there is VR's)&quot;. It took an effect's target actor as its MagicTarget* less 0x98, and checked that against ModifyActorValue's own Actor*." tooltip="Source: lab/frida/effect-stack-trace.js:15-17, :31, :71-84, :118-133" id="re1-h1">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-hcol">
            <mxGeometry x="10" y="33" width="580" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;x-dual-stack, run 20261013-061434: the check failed&lt;/b&gt;&lt;br&gt;A MagicTarget at Actor+0x98 read no form id on 1.6.1170. The stacking result stood on other evidence: all three effects read the same target field, and the first ModifyActorValue named the figure (ff00081d) as its own Actor. The offset was left to pin in a later run." tooltip="Source: docs/verbs/spell-cast.md:528-536; lab/results/20261013-061434-x-dual-stack.json" id="re1-h2">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-hcol">
            <mxGeometry x="10" y="111" width="580" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;What the header says&lt;/b&gt;&lt;br&gt;That comment, 098, 0A0, sits in the base list compiled without ENABLE_SKYRIM_AE (Actor.h:124-131). The accessor AsMagicTarget is RelocateMemberIfNewer(SKSE::RUNTIME_SSE_1_6_629, this, 0x98, 0xA0) (Actor.h:720-721): older and newer, not SE-and-AE and VR. By that reading 0xA0 on 1.6.1170, and MEASURED: in x-dual-cast3 (run 20261013-082306) the target field sat 160 (0xA0) past ModifyActorValue&#39;s own Actor*; the script now reads +0xA0 (thuum 444238d)." tooltip="Source: CommonLibSSE-NG include/RE/A/Actor.h:123-135, :720-725; lab/frida/effect-stack-trace.js (header); run 20261013-082306-x-dual-cast3, frida/c1-effect-stack-trace.js.jsonl (magicTargetInActor 160)" id="re1-h3">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4D4D4D;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-hcol">
            <mxGeometry x="10" y="201" width="580" height="86" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="re1-h3-b0" value="&lt;b&gt;HYPOTHESIS&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#595959;strokeColor=#595959;fontColor=#FFFFFF;fontSize=9;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;arcSize=50;spacingTop=0;spacingBottom=0;spacingLeft=0;spacingRight=0;" vertex="1" parent="re1-h3">
          <mxGeometry x="8" y="66" width="73" height="15" as="geometry" />
        </mxCell>
        <UserObject label="&lt;b&gt;Measured, not read: thuum 101c71b&lt;/b&gt;&lt;br&gt;The script now prints magicTargetInActor, the effect's target field less ModifyActorValue's own Actor*, with its first modify; probe x-dual-cast3 runs it (no result yet)." tooltip="Source: git log 101c71b (2026-10-12 23:46 PDT); lab/frida/effect-stack-trace.js:121-133; session scratchpad x-dual-cast3.yaml:9-10; lab/results (no x-dual-cast3 run)" id="re1-h4">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-hcol">
            <mxGeometry x="10" y="313" width="580" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Hard rule 8 (CLAUDE.md): what is left goes to the lab&lt;/b&gt;&lt;br&gt;Blocked on in-game behavior: write the Dynamic section of the verb doc (Frida script or breakpoint plan plus expected observations) and stop. Do not guess and do not loop on it. Page 2." tooltip="Source: CLAUDE.md:78-80 (Hard rules 8); docs/VERB.md:77-83" id="re1-f2">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-1">
            <mxGeometry x="1220" y="1019" width="580" height="52" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Why the scripts check offsets at runtime&lt;/b&gt;" tooltip="Source: lab/frida/*.js headers; lab/frida/README.md" id="re1-icol">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="re1-1">
            <mxGeometry x="1220" y="1095" width="580" height="185" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Offsets per exe file version&lt;/b&gt;&lt;br&gt;console-trace, launch-trace, poison-trace, effect-stack-trace and hud-trace keep each offset per runtime with its Address Library id beside it, and read SkyrimSE.exe's own file version (GetFileVersionInfoW, VS_FIXEDFILEINFO), as SKSE does. Another build gets an error line (&quot;no offsets for this runtime&quot;) and no hook." tooltip="Source: lab/frida/console-trace.js:11-22, :52-57; launch-trace.js:18-20; poison-trace.js:35-44, :75-79; effect-stack-trace.js:35-39, :86-90; hud-trace.js:20-25, :63-67" id="re1-i1">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-icol">
            <mxGeometry x="10" y="33" width="560" height="64" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Checks against the running game&lt;/b&gt;&lt;br&gt;face-dump.js checks the player singleton's class name first and refuses to run when the module is not 1.6.1170; effect-stack-trace.js checks its derived target against the call's own Actor. A script that throws at load prints its error in the first lines of its .out: read them right after attaching." tooltip="Source: lab/frida/face-dump.js:20-23; lab/frida/effect-stack-trace.js:118-133; lab/frida/README.md:91-93" id="re1-i2">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re1-icol">
            <mxGeometry x="10" y="109" width="560" height="64" as="geometry" />
          </mxCell>
        </UserObject>
