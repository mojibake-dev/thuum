          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Where this runs among the tiers (CLAUDE.md)&lt;/b&gt;&lt;br&gt;• T1 host-less native: CommonLib-based plugin code against the SkyrimSE.exe module outside the game; proves offsets and layouts resolve.&lt;br&gt;• T3 lab: two Windows clients plus the server, the only tier that proves a verb. Probes, scenarios and Frida traces run here, unattended.&lt;br&gt;• T4 human: breakpoints and visual judgment. LAB.md's human lane: x64dbg on a sky-dbg snapshot of sky-c1, the verb doc's breakpoint plan its script, Moonlight to watch." tooltip="Source: CLAUDE.md:142-155 (Testing tiers); docs/LAB.md:591-602 (Dynamic RE lane)" id="re2-tiers">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="re2-1">
