          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;sky-c1 and sky-c2, the lab's Windows clients (page 2)&lt;/b&gt;&lt;br&gt;The dist laid into every game folder (install-lab.ps1); lab-driver.js in Data\Platform\Plugins. A staging then snapshots each clone as clean-m1-next (page 3)." tooltip="Source: lab/tools/client-dist.sh; lab/tools/client-driver.sh; lab/deploy/sky-client/README.md; docs/LAB.md:451-465" id="b1-cl">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-1">
            <mxGeometry x="20" y="873" width="490" height="73" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;difftest-dist/&lt;/b&gt;&lt;br&gt;difftest and its sessions, a job artifact kept 30 days." tooltip="Source: skymp/.gitlab-ci.yml:58-73; lab/tools/test-proto.sh:76-96 (the commit's own artifact, else the branch's newest)" id="b1-dd">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;spacingTop=12;" vertex="1" parent="b1-1">
            <mxGeometry x="1570" y="1188" width="230" height="61" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;sky-srv, VM 700 (page 2)&lt;/b&gt;&lt;br&gt;docker compose pulls skymp-server:${SERVER_TAG} and thuum/lab-api:latest from the registry; the VM is dark, so images come only from sky-ci. T2 runs difftest from /srv/lab/difftest inside the server image (ADR-017)." tooltip="Source: lab/deploy/sky-srv/docker-compose.yml:1-10, 72-73; lab/deploy/sky-srv/README.md:21-22; lab/tools/test-proto.sh:20-23, 179-196; docs/DECISIONS.md ADR-017" id="b1-srv">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#B0E3E6;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-1">
            <mxGeometry x="970" y="1325" width="830" height="60" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Eli's Mac: Claude Code, the agent host (ADR-016)&lt;/b&gt;" tooltip="Source: docs/DECISIONS.md ADR-016; docs/LAB.md:96-98" id="b1-mac">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="b1-1">
            <mxGeometry x="570" y="240" width="340" height="1155" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;git push origin &amp;lt;branch&amp;gt;&lt;/b&gt;&lt;br&gt;One remote, two push URLs: GitLab (git@gitlab:root/&amp;lt;repo&amp;gt;.git) first, then GitHub; fetches come from GitHub. Never a force push: stacked branches take merges." tooltip="Source: git config remote.origin.pushurl in thuum and skymp; memory thuum-hosting-and-estate.md, feedback-no-force-push.md" id="b1-m0">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-mac">
            <mxGeometry x="10" y="42" width="320" height="73" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;just ci, ci-run, ci-log&lt;/b&gt;&lt;br&gt;lab/tools/glab.py on projects 6 and 7 with Keychain tokens. ci-run &amp;lt;project&amp;gt; [ref] starts an API pipeline, where every changes: rule counts as matched, so the image jobs run." tooltip="Source: lab/tools/glab.py:1-8, 22-30; justfile:248-255" id="b1-m1">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-mac">
            <mxGeometry x="10" y="127" width="320" height="73" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;gh workflow run parity-windows.yml --ref &amp;lt;branch&amp;gt;&lt;/b&gt;&lt;br&gt;A feature branch's Windows build. Dispatch once a wanted run has finished: a new run cancels it." tooltip="Source: skymp/.github/workflows/parity-windows.yml:17-24; memory thuum-hosting-and-estate.md (2026-10-07)" id="b1-m2">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-mac">
            <mxGeometry x="10" y="212" width="320" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;just build-client &amp;lt;branch&amp;gt;&lt;/b&gt;&lt;br&gt;gh run download -n dist: the newest successful run's dist into skymp/build/dist-client." tooltip="Source: justfile:50-59" id="b1-m3">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-mac">
            <mxGeometry x="10" y="512" width="320" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;just build-driver, client-dist, client-driver&lt;/b&gt;&lt;br&gt;lab-driver.js built here; the dist and the driver reach a clone through the jump root@core.gaussing.tv and its guest agent, the dist (too big for the agent's stdin) through a throwaway http.server on sky-srv." tooltip="Source: justfile:113-115, 365-367, 388-391; lab/tools/stage-client.sh:35-63; lab/tools/client-dist.sh; lab/tools/client-driver.sh" id="b1-m5">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-mac">
            <mxGeometry x="10" y="633" width="320" height="73" as="geometry" />
          </mxCell>
