        <UserObject label="&lt;b&gt;Traps the session met (session notes, 2026-10-02 to 2026-10-13)&lt;/b&gt;" tooltip="Source: memory thuum-hosting-and-estate.md, thuum-m2-poison-visuals.md; session scratchpad stage-branch.sh" id="b1-traps">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="b1-1">
