        <mxCell id="b2-leg" value="&lt;b&gt;Legend&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="b2-1">
