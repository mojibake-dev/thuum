          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A push pipeline judges changes: against the previous push only&lt;/b&gt;&lt;br&gt;So a superseded push can lose its image job. Push, then just ci-run, then push nothing until the image job has run." tooltip="Source: memory thuum-hosting-and-estate.md (2026-10-02); lab/tools/glab.py:5-8; session scratchpad stage-branch.sh:59-61" id="b1-t0">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-traps">
            <mxGeometry x="10" y="25" width="470" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;A commit outside skymp-wire builds no difftest&lt;/b&gt;&lt;br&gt;Only server-build runs (the Rust jobs are change-gated); T2 then takes the branch's newest difftest-build artifact." tooltip="Source: memory thuum-m2-poison-visuals.md (2026-10-13); lab/tools/test-proto.sh:76-88" id="b1-t1">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-traps">
            <mxGeometry x="10" y="80" width="470" height="47" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;The Windows run is flaky and cancellable&lt;/b&gt;&lt;br&gt;Its coverage test fails now and then, so a staging reruns a failed run up to twice; a dispatch during a wanted run cancels it." tooltip="Source: memory thuum-hosting-and-estate.md (2026-10-07); session scratchpad stage-branch.sh:33-46; skymp/.github/workflows/parity-windows.yml:22-24" id="b1-t2">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b1-traps">
            <mxGeometry x="10" y="135" width="470" height="47" as="geometry" />
          </mxCell>
        </UserObject>
