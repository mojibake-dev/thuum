          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Claude Code and the just recipes&lt;/b&gt;&lt;br&gt;Through Caddy (LAB_API): lab-up, lab-run, lab-status, client-snapshot, client-promote, probe, frida, playtest-start and -assist.&lt;br&gt;Through the jump: deploy-srv, test-proto, playtest-save and -restore, client-dist, client-driver, playtest-relaunch, persist-game, ghidra-import." tooltip="Source: justfile:11, 142-208, 210-246, 330-358, 365-391" id="b2-cc">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0E8088;fontColor=#000000;fontSize=10;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;" vertex="1" parent="b2-mac">
