        <UserObject label="&lt;b&gt;Proxmox host core, 10.0.0.10 (core.gaussing.tv on the tailnet): the SSH jump root@core.gaussing.tv&lt;/b&gt;" tooltip="Source: docs/LAB.md:17-47 (Topology), 100-121, 183-193; justfile:211 (srv_ssh: -J root@core.gaussing.tv)" id="b2-host">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#999999;fontColor=#000000;fontSize=12;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="b2-1">
            <mxGeometry x="320" y="227" width="1480" height="963" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;VLAN 70 vsky, 10.10.70.0/24, dark by default&lt;/b&gt;" tooltip="Source: docs/LAB.md:22, 49-64, 123-142" id="b2-vlan">
          <mxCell style="whiteSpace=wrap;html=1;fillColor=#F7F7F7;strokeColor=#8C8C8C;fontColor=#000000;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;spacingRight=6;spacingTop=3;spacingBottom=3;strokeWidth=1;fontFamily=Helvetica;rounded=1;absoluteArcSize=1;arcSize=10;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="b2-host">
            <mxGeometry x="340" y="54" width="820" height="891" as="geometry" />
