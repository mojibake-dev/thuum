# /srv/lab/.env on sky-srv. REGISTRY is the sky-ci registry with a trailing
# slash, or empty when images are loaded by hand. The Proxmox token is the
# pool-scoped lab-api token (Keychain sky-labapi on the Mac; CI variables
# PROXMOX_API_TOKEN on GitLab), split at the '=' into id and secret.
REGISTRY=10.10.70.12:5000/
PVE_TOKEN_ID=lab-api@pve!runner
PVE_TOKEN_SECRET=
